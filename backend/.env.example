# 环境配置
ENV=development
DEBUG=True

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./database/knowledge_base.db

# JWT配置
SECRET_KEY=your-super-secret-jwt-key-change-in-production-must-be-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24小时
REFRESH_TOKEN_EXPIRE_DAYS=7

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown,image/jpeg,image/png

# CORS配置
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_ROTATION=10MB
LOG_RETENTION=30 days

# 安全配置
BCRYPT_ROUNDS=12
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # 秒

# 搜索配置
SEARCH_RESULTS_PER_PAGE=20
MAX_SEARCH_RESULTS=1000

# 文件处理配置
ENABLE_FILE_VIRUS_SCAN=False
FILE_STORAGE_TYPE=local  # local, s3 (未来扩展)

# 应用信息
APP_NAME="团队知识库管理工具"
APP_VERSION="1.0.0"
APP_DESCRIPTION="基于FastAPI的团队知识库管理系统"